<%- include('../partials/header', { pageTitle: pageTitle }) %>

<div class="card narrow">
  <h2><%= pageTitle %></h2>

  <% if (errors.length > 0) { %>
    <div class="alert">
      <strong>Periksa kembali isian formulir:</strong>
      <ul>
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form action="<%= action %>" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label for="nim">NIM</label>
        <input type="text" id="nim" name="nim" value="<%= data.nim %>" maxlength="20" required>
      </div>
      <div class="form-group">
        <label for="no_hp">Nomor HP</label>
        <input type="tel" id="no_hp" name="no_hp" value="<%= data.no_hp %>" maxlength="20" required>
      </div>
    </div>

    <div class="form-group">
      <label for="nama_lengkap">Nama Lengkap</label>
      <input type="text" id="nama_lengkap" name="nama_lengkap" value="<%= data.nama_lengkap %>" maxlength="100" required>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="divisi">Divisi</label>
        <select id="divisi" name="divisi" required>
          <option value="">-- Pilih Divisi --</option>
          <% divisiList.forEach(d => { %>
            <option value="<%= d %>" <%= data.divisi === d ? 'selected' : '' %>><%= d %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="jabatan">Jabatan</label>
        <select id="jabatan" name="jabatan" required>
          <% jabatanList.forEach(j => { %>
            <option value="<%= j %>" <%= data.jabatan === j ? 'selected' : '' %>><%= j %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="tanggal_bergabung">Tanggal Bergabung</label>
        <input type="date" id="tanggal_bergabung" name="tanggal_bergabung" value="<%= data.tanggal_bergabung %>" required>
      </div>
      <div class="form-group">
        <label for="jumlah_kehadiran">Jumlah Kehadiran Rapat</label>
        <input type="number" id="jumlah_kehadiran" name="jumlah_kehadiran" value="<%= data.jumlah_kehadiran %>" min="0" max="999" required>
      </div>
    </div>

    <div class="form-group">
      <label for="status">Status</label>
      <select id="status" name="status" required>
        <% statusList.forEach(s => { %>
          <option value="<%= s %>" <%= data.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="catatan">Catatan (opsional)</label>
      <textarea id="catatan" name="catatan" rows="3" maxlength="1000"><%= data.catatan %></textarea>
    </div>

    <button type="submit" class="btn btn-primary"><%= labelTombol %></button>
    <a href="/panitia" class="btn btn-light">Batal</a>
  </form>
</div>

<%- include('../partials/footer') %>
